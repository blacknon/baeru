Output assets/cli-demo.gif

Require cargo
Require ./target/debug/baeru

Set Shell "bash"
Set FontSize 26
Set Width 1280
Set Height 720
Set Padding 24
Set Margin 12
Set MarginFill "#0b1220"
Set BorderRadius 18
Set Theme "Builtin Solarized Dark"
Set WindowBar Colorful
Set TypingSpeed 0ms
Set Framerate 30

Type "./target/debug/baeru --backend cli -- ls -la"
Enter

Sleep 3s
